<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.vptr</groupId>
    <artifactId>midas-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>midas-gui</artifactId>
  <version>${revision}</version>
  <packaging>quarkus</packaging>

  <properties>
    <openapi-generator-plugin.version>7.25.0</openapi-generator-plugin.version>
    <nullaway.annotated.packages>de.vptr.midas.gui</nullaway.annotated.packages>

    <assertj.version>3.27.7</assertj.version>
    <line-awesome.version>2.1.0</line-awesome.version>
    <vaadin.version>25.3.0</vaadin.version>
    <!-- Node.js for every Vaadin frontend build. vaadin-maven-plugin reads these two properties
    directly; quarkus-maven-plugin passes them to the Quarkus build step and to dev mode (see its
    systemProperties). Vaadin downloads this version to ~/.vaadin instead of using a node on PATH,
    so the npm bundled with it, and with that package-lock.json, is the same on every machine.
    Bump together with vaadin.version, to the new release's FrontendTools.DEFAULT_NODE_VERSION. -->
    <vaadin.node.version>v24.21.0</vaadin.node.version>
    <vaadin.require.home.node>true</vaadin.require.home.node>
    <!-- npm ci instead of npm install: installs exactly what package-lock.json records and fails
    the build when package.json and the lockfile disagree, instead of rewriting the lockfile.
    Off only in `make regen-lockfile`, which updates the lockfile. -->
    <vaadin.ci.build>true</vaadin.ci.build>
    <!-- Jackson 3 security pin (transitive via Vaadin). See dependencyManagement. -->
    <jackson3.version>3.1.7</jackson3.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.vaadin</groupId>
        <artifactId>vaadin-bom</artifactId>
        <version>${vaadin.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Pin Jackson 3 to fix CVEs. Neither the Quarkus nor the Vaadin BOM manages
      tools.jackson.*, so this BOM is declared last: it only fills in those unmanaged versions and
      cannot override the Quarkus-managed com.fasterxml.jackson.core:jackson-annotations (which
      this BOM also lists, and which Jackson 2 shares).
        3.1.5 -> 3.1.7, transitive via Vaadin (flow-server), fixes:
          - CVE-2026-68497 (high): unbounded number parse DoS via Duration / XMLGregorianCalendar
          - CVE-2026-19032: java.nio.file.Path deserialization has no URI scheme allowlist
          - CVE-2026-83557: Comparable missing from the default polymorphic base-type denylist
          - CVE-2026-91776: unbounded type id cache growth
          - CVE-2026-91777: quadratic forward-reference resolution
          Stays on the 3.1.x line Vaadin 25.3 is built against rather than moving to 3.2.x, which
          needs com.fasterxml.jackson.core:jackson-annotations 2.22 (Quarkus manages 2.21).
          Jackson 2 (via Quarkus) is already patched at 2.21.7.
      Vaadin cannot resolve this by version bump: 25.3.0 is the newest release and ships 3.1.5.
      Remove this pin once Vaadin manages tools.jackson.core >= 3.1.7. -->
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson3.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Vaadin -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-quarkus-extension</artifactId>
      <version>${vaadin.version}</version>
    </dependency>

    <!-- Quarkus (module-specific) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-caffeine</artifactId>
    </dependency>

    <!-- Test (GUI-specific) -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Other dependencies -->
    <dependency>
      <groupId>org.parttio</groupId>
      <artifactId>line-awesome</artifactId>
      <version>${line-awesome.version}</version>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>vaadin-prereleases</id>
      <url>https://maven.vaadin.com/vaadin-prereleases/</url>
    </repository>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>Vaadin Directory</id>
      <url>https://maven.vaadin.com/vaadin-addons</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </pluginRepository>
    <pluginRepository>
      <id>vaadin-prereleases</id>
      <url>https://maven.vaadin.com/vaadin-prereleases/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <!-- Generates the REST client interfaces and response DTOs from the API's committed contract.
      Request DTOs stay hand-written: they double as view models and carry fields the contract's
      request schemas lack. AuthClient and BackendHealthClient stay hand-written too: the first
      sends credentials before a session exists, the second targets an endpoint outside the
      contract. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/../midas-api/openapi.yaml</inputSpec>
              <generatorName>java</generatorName>
              <library>microprofile</library>
              <templateDirectory>${project.basedir}/src/main/openapi-templates</templateDirectory>
              <apiPackage>de.vptr.midas.gui.client</apiPackage>
              <modelPackage>de.vptr.midas.gui.dto</modelPackage>
              <apiNameSuffix>Client</apiNameSuffix>
              <!-- By tag. SmallRye tags AuthResource "Auth Resource" by itself, so listing the
              others is what keeps AuthClient hand-written. -->
              <apisToGenerate>Account,Page,Payment,Post,PostCategory,PostComment,User,UserGroup,UserRank</apisToGenerate>
              <modelsToGenerate>AccountAccessResponseDto,AccountAssociationResponseDto,AccountResponseDto,ApiErrorResponse,BalancePointDto,BalanceResponseDto,PageResponseDto,PaymentResponseDto,PostCategoryResponseDto,PostCommentResponseDto,PostResponseDto,UserGroupResponseDto,UserRankResponseDto,UserResponseDto</modelsToGenerate>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <!-- 3.0 selects the jakarta.* namespace; the default is still javax.* -->
                <microprofileRestClientVersion>3.0</microprofileRestClientVersion>
                <serializationLibrary>jackson</serializationLibrary>
                <configKey>midas-api</configKey>
                <dateLibrary>java8-localdatetime</dateLibrary>
                <!-- ApiException is checked and cannot pass through the ServiceHelper lambdas;
                without the mapper, errors arrive as WebApplicationException instead. -->
                <microprofileRegisterExceptionMapper>false</microprofileRegisterExceptionMapper>
                <!-- One XxxRequest builder per operation with parameters, set by name: the generator
                orders query parameters alphabetically, so positional LocalDates read (endDate,
                startDate) and a swapped call compiles. @BeanParam sends the same request. -->
                <useSingleRequestParameter>true</useSingleRequestParameter>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <configuration>
          <systemProperties>
            <!-- vaadin.build.*: Quarkus build step; vaadin.*: dev mode's runtime dev server -->
            <vaadin.build.node-version>${vaadin.node.version}</vaadin.build.node-version>
            <vaadin.build.require-home-node-exec>${vaadin.require.home.node}</vaadin.build.require-home-node-exec>
            <vaadin.build.ci-build>${vaadin.ci.build}</vaadin.build.ci-build>
            <vaadin.node.version>${vaadin.node.version}</vaadin.node.version>
            <vaadin.require.home.node>${vaadin.require.home.node}</vaadin.require.home.node>
          </systemProperties>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.vaadin</groupId>
        <artifactId>vaadin-maven-plugin</artifactId>
        <version>${vaadin.version}</version>
        <configuration>
          <cleanFrontendFiles>false</cleanFrontendFiles>
        </configuration>
      </plugin>
      <!-- Generated sources are excluded from the gates (see also -XepExcludedPaths in the root
      pom, spotbugs-exclude.xml, and JaCoCo's dto exclude). The generated clients are interfaces
      without executable code, so JaCoCo has nothing to count in them. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <sourceDirectories>
            <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
          </sourceDirectories>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <configuration>
          <excludeRoots>
            <excludeRoot>${project.build.directory}/generated-sources</excludeRoot>
          </excludeRoots>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>org/jboss/**</exclude>
                <exclude>io/netty/**</exclude>
              </excludes>
            </configuration>
          </execution>
          <!-- Bound to post-integration-test, not test: failsafe runs the *IT tests at
          integration-test and appends to the same jacoco.exec, so a report generated at
          test would omit all integration-test coverage. Still runs when ITs are skipped. -->
          <execution>
            <id>report</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <skip>${jacoco.check.skip}</skip>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <excludes>
            <exclude>de/vptr/midas/gui/view/**</exclude>
            <exclude>de/vptr/midas/gui/component/**</exclude>
            <!-- Generated response DTOs and hand-written forms. The hand-written from() mappers are
            covered by DtoFromTest rather than held to the gate. -->
            <exclude>de/vptr/midas/gui/dto/**</exclude>
            <exclude>de/vptr/midas/gui/exception/**</exclude>
            <exclude>de/vptr/midas/gui/service/RestClientInitializer*</exclude>
            <exclude>de/vptr/midas/gui/util/UiConstants*</exclude>
            <exclude>de/vptr/midas/gui/util/NotificationUtil*</exclude>
            <exclude>de/vptr/midas/gui/util/MidasErrorHandler*</exclude>
            <exclude>de/vptr/midas/gui/util/UiAsyncExecutor*</exclude>
            <exclude>de/vptr/midas/gui/util/PostUiUtil*</exclude>
            <exclude>de/vptr/midas/gui/util/ServiceHelper*</exclude>
            <exclude>de/vptr/midas/gui/AppLifecycleBean*</exclude>
            <exclude>de/vptr/midas/gui/AppConfig*</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>production</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-maven-plugin</artifactId>
            <version>${vaadin.version}</version>
            <executions>
              <execution>
                <phase>compile</phase>
                <goals>
                  <goal>prepare-frontend</goal>
                  <goal>build-frontend</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>