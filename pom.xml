<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.vptr</groupId>
  <artifactId>midas-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
    <skipITs>true</skipITs>
    <!-- Deliberately NOT ${skipITs} (which is what the sibling AIMathTutor project uses):
    that project's coverage minima are calibrated against a run that includes its *IT
    tests, so the check has to stand down when ITs are skipped. This project has no *IT
    classes at all, so its minima are unit-test-only and the check must always run.
    Revisit this the moment integration tests are introduced here. -->
    <jacoco.check.skip>false</jacoco.check.skip>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <pmd-cpd.minTokens>65</pmd-cpd.minTokens>

    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.version>3.33.3.2</quarkus.platform.version>

    <checkstyle.version>14.1.0</checkstyle.version>
    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    <compiler-plugin.version>3.16.0</compiler-plugin.version>
    <dependency-check-plugin.version>13.0.0</dependency-check-plugin.version>
    <eclipse-formatter.version>4.40</eclipse-formatter.version>
    <error-prone.version>2.50.0</error-prone.version>
    <jacoco-plugin.version>0.8.14</jacoco-plugin.version>
    <license-plugin.version>2.7.1</license-plugin.version>
    <!-- Netty security pin (transitive via Quarkus). See dependencyManagement. -->
    <netty.version>4.1.138.Final</netty.version>
    <nullaway.version>0.14.1</nullaway.version>
    <pmd-plugin.version>3.28.0</pmd-plugin.version>
    <spotbugs-annotations.version>4.10.4</spotbugs-annotations.version>
    <spotbugs-plugin.version>4.10.4.1</spotbugs-plugin.version>
    <spotless-plugin.version>3.10.2</spotless-plugin.version>
    <surefire-plugin.version>3.6.0</surefire-plugin.version>
  </properties>

  <modules>
    <module>midas-api</module>
    <module>midas-gui</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Pin Netty to fix CVEs. Declared before the Quarkus BOM so this BOM wins version
      resolution over the Quarkus managed version. Applies to both modules: midas-api serves
      REST through the Quarkus Vert.x/Netty HTTP server, and midas-gui serves Vaadin through the
      same server (the Vaadin BOM imported in midas-gui manages no io.netty artifact, so this
      pin is not overridden there).
        4.1.136.Final -> 4.1.138.Final, transitive via Quarkus, fixes:
          Published advisories:
          - CVE-2026-75595 (critical): SNI routing bypass via fragmented TLS ClientHello falls
            back to the default SslContext (netty-handler)
          - CVE-2026-75596: fragmented ClientHello records trigger quadratic pre-handshake
            reassembly in SNI parsing (netty-handler)
          - CVE-2026-59903: CORS Vary header overwrite enables cache poisoning (netty-codec-http)
          Additionally, 4.1.138.Final fixes a batch of advisories whose CVE IDs were not yet
          assigned at the time of this pin: request smuggling and header validation gaps in the
          HTTP/1.1 and HTTP/2 codecs, unbounded resource usage in HTTP/1.1, SPDY, SMTP, MQTT and
          Redis codecs, a HAProxy decoder memory leak, and OCSP certificate validation. Pinning
          4.1.137.Final (the first patched version for the three published CVEs) would leave
          that batch to reopen as alerts once published.
          Reachability was not assessed per CVE; the TLS/SNI ones only matter when TLS terminates
          in-app rather than at a reverse proxy.
      Quarkus cannot resolve this by platform bump: 3.33.3.2 is the newest 3.33.x and manages
      Netty at 4.1.136.Final, and this project stays on the 3.33 LTS stream.
      Remove this pin once Quarkus 3.33.x manages Netty >= 4.1.138.Final. -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Quarkus -->
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Quarkus Core (shared) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>

    <!-- Test (shared) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-mockito</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jacoco</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Other -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>${spotbugs-annotations.version}</version>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>${quarkus.platform.group-id}</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
          <extensions>true</extensions>
          <configuration>
            <jvmArgs>--add-opens java.base/java.lang=ALL-UNNAMED
              --add-opens java.base/jdk.internal.ref=ALL-UNNAMED
              --add-opens java.base/jdk.internal.misc=ALL-UNNAMED
              --add-opens java.base/java.nio=ALL-UNNAMED
              --add-opens java.base/sun.nio.ch=ALL-UNNAMED
              --enable-native-access=ALL-UNNAMED
              --sun-misc-unsafe-memory-access=allow
              -XX:+EnableDynamicAgentLoading
              -Xshare:off</jvmArgs>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>build</goal>
                <goal>generate-code</goal>
                <goal>generate-code-tests</goal>
                <goal>native-image-agent</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler-plugin.version}</version>
          <configuration>
            <parameters>true</parameters>
            <compilerArgs>
              <!--
                -Werror: any compiler warning (javac lint or Error Prone) fails the build.
                -Xlint:all with three deliberate exclusions:
                  -serial: Vaadin components are Serializable by inheritance; adding
                           serialVersionUID is unwanted boilerplate (same decision as the
                           SE_ exclusions in spotbugs-exclude.xml)
                  -this-escape: flags the standard Vaadin constructor-builds-UI idiom,
                           not actual bugs
                  -classfile: noise from third-party jars referencing optional annotations
                           (e.g. OSGi metadata in microprofile-config); not fixable here
              -->
              <arg>-Werror</arg>
              <arg>-Xlint:all,-serial,-this-escape,-classfile</arg>
              <arg>-XDcompilePolicy=simple</arg>
              <arg>-Xplugin:ErrorProne -Xep:NullAway:ERROR
                -XepOpt:NullAway:AnnotatedPackages=${nullaway.annotated.packages}
                -Xep:FutureReturnValueIgnored:ERROR
                -Xep:NullablePrimitive:ERROR
                -Xep:NonApiType:ERROR
                -Xep:MultipleNullnessAnnotations:ERROR
                -Xep:JavaDurationGetSecondsToToSeconds:ERROR
                -Xep:JavaTimeDefaultTimeZone:ERROR
                -Xep:StringSplitter:ERROR
                -Xep:StringConcatToTextBlock:ERROR
                -Xep:StatementSwitchToExpressionSwitch:ERROR
                -Xep:UnnecessaryAssignment:ERROR
                -Xep:UnnecessaryMethodReference:ERROR
                -Xep:UnusedVariable:ERROR
                -Xep:EffectivelyPrivate:ERROR</arg>
              <arg>--should-stop=ifError=FLOW</arg>
            </compilerArgs>
            <annotationProcessorPaths>
              <path>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_core</artifactId>
                <version>${error-prone.version}</version>
              </path>
              <path>
                <groupId>com.uber.nullaway</groupId>
                <artifactId>nullaway</artifactId>
                <version>${nullaway.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire-plugin.version}</version>
          <configuration>
            <argLine>-Xshare:off -XX:+EnableDynamicAgentLoading @{argLine}</argLine>
            <includes>
              <include>**/*Test.java</include>
            </includes>
            <systemPropertyVariables>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <maven.home>${maven.home}</maven.home>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${surefire-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <!-- Mirrors surefire. @{argLine} carries the JaCoCo agent, which failsafe would
            otherwise inherit only implicitly via the argLine property, and would lose
            silently the moment any explicit argLine is added here. -->
            <argLine>-Xshare:off -XX:+EnableDynamicAgentLoading @{argLine}</argLine>
            <systemPropertyVariables>
              <native.image.path>
                ${project.build.directory}/${project.build.finalName}-runner</native.image.path>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <maven.home>${maven.home}</maven.home>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>${license-plugin.version}</version>
          <executions>
            <execution>
              <id>add-third-party</id>
              <phase>verify</phase>
              <goals>
                <goal>add-third-party</goal>
              </goals>
              <configuration>
                <failOnMissing>true</failOnMissing>
                <failOnBlacklist>true</failOnBlacklist>
                <excludedLicenses>
                  Commercial||Proprietary||SSPL||Elastic License||Business Source
                  License||Commons Clause||Elastic License 2.0||Server Side Public
                  License||BUSL-1.1||Polyform||PolyForm
                </excludedLicenses>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>${dependency-check-plugin.version}</version>
          <configuration>
            <failBuildOnCVSS>7</failBuildOnCVSS>
            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
            <suppressionFiles>
              <suppressionFile>${project.basedir}/dependency-check-suppression.xml</suppressionFile>
            </suppressionFiles>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-plugin.version}</version>
          <configuration>
            <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
            <effort>Max</effort>
            <threshold>Low</threshold>
          </configuration>
          <executions>
            <execution>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${pmd-plugin.version}</version>
          <configuration>
            <minimumTokens>${pmd-cpd.minTokens}</minimumTokens>
            <targetJdk>${java.version}</targetJdk>
            <includeTests>true</includeTests>
            <linkXRef>false</linkXRef>
            <rulesets>
              <ruleset>${project.basedir}/pmd-ruleset.xml</ruleset>
            </rulesets>
            <failOnViolation>true</failOnViolation>
          </configuration>
          <executions>
            <execution>
              <id>pmd-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
            <execution>
              <id>cpd-check</id>
              <phase>verify</phase>
              <goals>
                <goal>cpd-check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${checkstyle-plugin.version}</version>
          <dependencies>
            <!-- Pin the Checkstyle engine itself; the plugin otherwise runs whatever
                 (much older) version it bundles, and checkstyle.version would be dead. -->
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
          <executions>
            <execution>
              <id>checkstyle</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
            <propertyExpansion>
              org.checkstyle.google.suppressionfilter.config=${project.basedir}/checkstyle-suppressions.xml</propertyExpansion>
            <consoleOutput>true</consoleOutput>
            <failsOnError>true</failsOnError>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-plugin.version}</version>
          <configuration>
            <java>
              <eclipse>
                <file>${maven.multiModuleProjectDirectory}/eclipse-formatter.xml</file>
                <version>${eclipse-formatter.version}</version>
                <!-- download.eclipse.org suffers recurring outages; provision P2 from a mirror -->
                <p2Mirrors>
                  <p2Mirror>
                    <prefix>https://download.eclipse.org/</prefix>
                    <url>https://ftp.halifax.rwth-aachen.de/eclipse/</url>
                  </p2Mirror>
                </p2Mirrors>
              </eclipse>
              <importOrder>
                <order>java,javax,org,com,#</order>
              </importOrder>
              <removeUnusedImports />
            </java>
          </configuration>
          <executions>
            <execution>
              <id>spotless-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <skipITs>false</skipITs>
        <quarkus.native.enabled>true</quarkus.native.enabled>
      </properties>
    </profile>
  </profiles>
</project>