<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- devkit's Quarkus parent POM configures and activates every quality gate plus Quarkus'
  platform BOM, plugin and test dependencies; this pom keeps only the project's own values. Maven
  reads it through the .devkit link devkitw creates. -->
  <parent>
    <groupId>de.vptr.devkit</groupId>
    <artifactId>devkit-quarkus-parent</artifactId>
    <version>0.9.0</version>
    <relativePath>.devkit/java/quarkus/pom.xml</relativePath>
  </parent>

  <groupId>de.vptr</groupId>
  <artifactId>midas-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
    <!-- Deliberately NOT ${skipITs} (which is what the sibling AIMathTutor project uses):
    that project's coverage minima are calibrated against a run that includes its *IT
    tests, so the check has to stand down when ITs are skipped. This project has no *IT
    classes at all, so its minima are unit-test-only and the check must always run.
    Revisit this the moment integration tests are introduced here. -->
    <jacoco.check.skip>false</jacoco.check.skip>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>

    <!-- generated sources (midas-gui's openapi-generator output) are not ours to fix; a no-op in
    a module that generates none -->
    <error-prone.extra.args>-XepExcludedPaths:.*/generated-sources/.*</error-prone.extra.args>

    <!-- TestUtil's REST Assured helpers and statusCode, which midas-api tests use as their only
    assertion; PMD counts none of them as one unless named here -->
    <pmd.extraAssertMethodNames>statusCode,testAuthorizedGetWithExistingResource,testAuthorizedGetWithExistingResourceAndJson,testAuthorizedGetWithJson,testAuthorizedGetWithNonExistentResource,testAuthorizedPatchWithJson,testAuthorizedPostWithCreation,testAuthorizedPostWithInsufficientRole,testAuthorizedPostWithSyntaxError,testAuthorizedPostWithValidationError,testAuthorizedPutWithJson,testAuthorizedSearchWithJson,testUnauthorizedAccess,testUnauthorizedDelete,testUnauthorizedPatch,testUnauthorizedPost,testUnauthorizedPut</pmd.extraAssertMethodNames>
  </properties>

  <modules>
    <module>midas-api</module>
    <module>midas-gui</module>
  </modules>

  <dependencies>
    <!-- Quarkus Core (shared) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>

    <!-- Test (shared) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-mockito</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Other -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
    </dependency>
  </dependencies>
</project>