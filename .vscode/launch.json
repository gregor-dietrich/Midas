{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(API) Debug Quarkus application",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005,
      "preLaunchTask": "api-quarkus:dev"
    },
    {
      "name": "(GUI) Debug Quarkus application",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 5006,
      "preLaunchTask": "gui-quarkus:dev"
    },
    {
      "type": "java",
      "name": "(API) Debug (Attach) Quarkus application",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005,
      "timeout": 30000
    },
    {
      "type": "java",
      "name": "(GUI) Debug (Attach) Quarkus application",
      "request": "attach",
      "hostName": "localhost",
      "port": 5006,
      "timeout": 30000
    },
    {
      "name": "(Test) Debug Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "main.py", "--server.port", "8501"],
      "jinja": true,
      "justMyCode": true
    }
  ]
}
